# ============================================
# 环境变量配置文件
# ============================================

# --- 绑定配置（服务端监听用）---
# 本地部署：0.0.0.0（监听所有网卡）或 127.0.0.1（仅本机）
# 公网部署：0.0.0.0
BIND_HOST=0.0.0.0

# --- 对外访问配置（生成跳转URL、返回给前端用）---
# 本地部署：127.0.0.1 或 localhost
# 公网部署：你的真实IP或域名，如 example.com
PUBLIC_HOST=127.0.0.1

# --- 协议 ---
# 本地部署：http
# 公网部署：https（若已配证书/Nginx）
PUBLIC_PROTO=http

# --- 端口配置 ---
# 主站端口
MAIN_SERVER_PORT=5000
# 调色板子站端口
PALETTE_SERVER_PORT=5001

# --- 反代场景下的对外端口（可选）---
# 若通过 Nginx 反代到 80/443，浏览器实际访问的端口
# 留空则使用上面的服务端口
PUBLIC_PORT=

# 本地开发 True，公网部署 False
DEBUG=True